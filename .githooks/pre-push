#!/usr/bin/env bash
# Antes de cada push, solo comprobaciones instantáneas: las novedades traen tests e2e y su mutación, el código trae
# tests y la nota de mutaciones no baja (tools/require-tests.js), los e2e cambiados no añaden atajos ni comprobaciones
# complacientes (tools/e2e-lint.js), el catálogo de mutaciones está al día (tools/mutar.js --lista), y las notas de
# parche y las traducciones están bien. Rojo primero (tools/rojo-primero.js) lo pasa el CI: tarda. Los tests (npm test y la tanda
# e2e completa) los pasa el CI en cada push a develop y main, y sin ellos no se despliega.
# Para pasarlos también aquí: LOCAL_TESTS=1 git push (npm test y los e2e relacionados con lo que se sube) o
# E2E_ALL=1 git push (npm test y todos los e2e).
# Se activa solo con `npm ci`/`npm install` (script prepare: git config core.hooksPath .githooks).
set -uo pipefail
cd "$(git rev-parse --show-toplevel)" || exit 1
zero=0000000000000000000000000000000000000000
checked=0
related=""
while read -r local_ref local_sha remote_ref remote_sha; do
  [ "$local_sha" = "$zero" ] && continue   # borrar una rama: nada que comprobar
  node tools/require-tests.js "$remote_sha" "$local_sha" "$remote_ref" || exit 1
  base="$remote_sha"
  if [ "$base" = "$zero" ]; then base=$(git merge-base "$local_sha" origin/develop 2>/dev/null || echo "$local_sha"); fi
  node tools/e2e-lint.js --base "$base" >/dev/null || { node tools/e2e-lint.js --base "$base"; exit 1; }
  related="$related $(node tools/e2e-related.js "$base" "$local_sha")"
  checked=1
done
[ "$checked" = 1 ] || exit 0

if ! node tools/changelog-check.js >/dev/null || ! node tools/i18n-check.js --strict >/dev/null || ! node tools/mutar.js --lista >/dev/null; then
  node tools/changelog-check.js; node tools/i18n-check.js --strict | grep -E "falta|✗" | head -20; node tools/mutar.js --lista; exit 1
fi
if [ -z "${LOCAL_TESTS:-}${E2E_ALL:-}" ]; then
  echo "✓ Comprobaciones correctas: se sube (los tests los pasa el CI)."
  exit 0
fi

if [ ! -d node_modules ]; then echo "✗ Falta node_modules: ejecuta npm ci antes de subir"; exit 1; fi
if [ -n "$(git status --porcelain --untracked-files=no)" ]; then
  echo "Aviso: hay cambios sin commit; los tests se pasan sobre lo que hay en la carpeta, no solo sobre lo que subes."
fi
log=$(mktemp)
if [ -n "${E2E_ALL:-}" ]; then e2e_files=""; what="todos los e2e"
else e2e_files=$(printf '%s\n' $related | sort -u | tr '\n' ' '); what="e2e relacionados: $(printf '%s\n' $e2e_files | sed 's#tests/e2e/##; s#\.e2e\.js##' | tr '\n' ' ')"; fi
echo "Pasando npm test y $what antes de subir…"
if ! npm test >"$log" 2>&1; then
  echo "✗ npm test falla:"; grep -E "✗|Error|fallos|falla" "$log" | head -30; echo "(registro completo: $log)"; exit 1
fi
# shellcheck disable=SC2086
if ! node tools/e2e.js $e2e_files >"$log" 2>&1; then
  echo "✗ Los tests e2e fallan:"; grep -E "✗|error|captura|fallan" "$log" | head -30; echo "(registro completo: $log)"; exit 1
fi
rm -f "$log"
echo "✓ Tests correctos: se sube."
