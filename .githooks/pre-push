#!/usr/bin/env bash
# Antes de cada push: las novedades traen tests e2e y el código trae tests (tools/require-tests.js), y
# toda la batería pasa (npm test y los e2e en un navegador). Se activa solo con `npm ci`/`npm install`
# (script prepare: git config core.hooksPath .githooks). El CI comprueba lo mismo, así que saltárselo
# con --no-verify solo retrasa el problema: sin tests no se despliega.
set -uo pipefail
cd "$(git rev-parse --show-toplevel)" || exit 1
zero=0000000000000000000000000000000000000000
checked=0
while read -r local_ref local_sha remote_ref remote_sha; do
  [ "$local_sha" = "$zero" ] && continue   # borrar una rama: nada que comprobar
  node tools/require-tests.js "$remote_sha" "$local_sha" "$remote_ref" || exit 1
  checked=1
done
[ "$checked" = 1 ] || exit 0

if [ ! -d node_modules ]; then echo "✗ Falta node_modules: ejecuta npm ci antes de subir"; exit 1; fi
if [ -n "$(git status --porcelain --untracked-files=no)" ]; then
  echo "Aviso: hay cambios sin commit; los tests se pasan sobre lo que hay en la carpeta, no solo sobre lo que subes."
fi
log=$(mktemp)
echo "Pasando todos los tests antes de subir (npm test y e2e; un par de minutos)…"
if ! npm test >"$log" 2>&1; then
  echo "✗ npm test falla:"; grep -E "✗|Error|fallos|falla" "$log" | head -30; echo "(registro completo: $log)"; exit 1
fi
if ! npm run --silent test:e2e >"$log" 2>&1; then
  echo "✗ Los tests e2e fallan:"; grep -E "✗|error|captura|fallan" "$log" | head -30; echo "(registro completo: $log)"; exit 1
fi
rm -f "$log"
echo "✓ Tests correctos: se sube."
